{% liquid
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
%}

<section class="section">
  <div class="section__content container">
    {% content_for 'blocks' %}
  </div>
</section>

{% style %}
  .section {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    background-color: {{ background_color }};
  }
  .section__content {
    color: {{ text_color }};

    * {
      color: inherit;
    }
  }
{% endstyle %}

{% stylesheet %}
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
  ],
  "presets": [
    {
      "name": "Section"
    }
  ]
}
{% endschema %}