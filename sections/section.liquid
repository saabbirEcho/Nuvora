{% liquid
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
%}

<section class="section color-{{ section.settings.color_scheme }}">
  <div class="section__content container">
    {% content_for 'blocks' %}
  </div>
</section>

{% style %}
  .section {
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    background-color: var(--color-background);
  }
  /* .section__content {
    color: var(--color-text);

    * {
      color: inherit;
    }
  } */
{% endstyle %}

{% stylesheet %}
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
  ],
  "presets": [
    {
      "name": "Section"
    }
  ]
}
{% endschema %}