{%- liquid
  assign primary_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
  assign primary_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
  assign primary_font_bold_italic = primary_font_bold | font_modify: 'style', 'italic'
%}

{% style %}
{% for scheme in settings.color_schemes %}
  .color-{{ scheme.id }} {
    --color-background: {{ scheme.settings.background }};
    --color-text: {{ scheme.settings.text }};
    --color-primary-button: {{ scheme.settings.primary_button }};
    --color-primary-button-text: {{ scheme.settings.primary_button_text }};
    --color-primary-button-border: {{ scheme.settings.primary_button_border }};
    --color-secondary-button: {{ scheme.settings.secondary_button }};
    --color-secondary-button-text: {{ scheme.settings.secondary_button_text }};
    --color-secondary-button-border: {{ scheme.settings.secondary_button_border }};
    --color-links: {{ scheme.settings.links }};
    --color-icons: {{ scheme.settings.icons }};
  }
{% endfor %}
{% endstyle %}

<script>
  const designTokens = {
    fonts: {
      primary: {
        regular: '{{ settings.type_body_font.family }}',
        bold: '{{ primary_font_bold.family }}',
        italic: '{{ primary_font_italic.family }}',
        boldItalic: '{{ primary_font_bold_italic.family }}',
      },
    },
  };
</script>